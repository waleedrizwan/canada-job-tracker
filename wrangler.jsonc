// Cloudflare hosting for the static site that tools/build-site.sh builds into dist/.
// It's static files only (no Worker code runs): the page draws the treemap from data.json.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "canada-job-tracker",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist",
		// Every URL gets index.html, which is the whole site.
		"not_found_handling": "single-page-application"
	},
	// Cloudflare builds other branches (pull requests) with `wrangler preview`, which needs this
	// block to make a preview link. It can be empty: the settings above apply to previews too.
	"previews": {}
}
